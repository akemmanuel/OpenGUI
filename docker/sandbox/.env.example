# A separate copy of this directory and env file is required for each customer.
OPENGUI_SANDBOX_NAME=opengui-customer
OPENGUI_SANDBOX_PORT=4840
OPENGUI_BASE_URL=https://customer-gui.example.com
OPENGUI_WORKSPACE=/home/opengui-customer/workspace

# Use a stable random value of at least 32 bytes. Keep the real .env mode 0600.
OPENGUI_AUTH_SECRET=replace-with-a-stable-random-secret

# A write-enabled GitHub deploy key scoped to exactly the customer's repository.
OPENGUI_GITHUB_DEPLOY_KEY_FILE=/home/opengui-customer/secrets/github-deploy-key
OPENGUI_GITHUB_KNOWN_HOSTS_FILE=/home/opengui-customer/secrets/github-known-hosts

OPENGUI_IMAGE=ghcr.io/akemmanuel/opengui:0.6.0-rc.2
OPENGUI_SANDBOX_RUNTIME=runsc
OPENGUI_SANDBOX_MEMORY=3g
OPENGUI_SANDBOX_CPUS=2.0
