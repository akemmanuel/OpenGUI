{
  "name": "opengui",
  "version": "0.6.0",
  "private": false,
  "description": "OpenGUI - first-party coding agent for desktop and web",
  "homepage": "https://github.com/akemmanuel/OpenGUI",
  "license": "MIT",
  "author": {
    "name": "Emmanuel",
    "email": "emmanuel@akemsoft.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akemmanuel/OpenGUI.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "node ./scripts/ensure-electron.mjs",
    "prepare": "vp config",
    "dev": "node --experimental-strip-types scripts/dev-desktop.ts",
    "dev:web": "HOST=0.0.0.0 vp dev --host 0.0.0.0",
    "prototype:oauth-auth": "HOST=0.0.0.0 vp dev --host 0.0.0.0 --open /prototype-oauth-auth.html?variant=A",
    "build": "vp build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:fix": "vp fmt --fix",
    "test": "vp test",
    "test:coverage": "vp exec vitest run --config vitest.coverage.config.ts --coverage",
    "test:frontend": "vp test src/components src/features src/hooks src/lib src/protocol src/runtime src/shell src/i18n",
    "test:desktop": "vp test src/runtime src/shell ../main ../server ../scripts/dev-desktop-helpers.test.ts ../scripts/electron-package-metadata.test.ts ../scripts/process-tree.test.ts ../settings-store.test.ts",
    "test:backend": "vp test packages/backend",
    "test:e2e": "node --experimental-strip-types scripts/browser-acceptance.ts && node --experimental-strip-types scripts/browser-acceptance-multi-user.ts",
    "test:e2e:multi-user": "node --experimental-strip-types scripts/browser-acceptance-multi-user.ts",
    "test:responsive:provision": "agent-browser install",
    "test:responsive:detector": "vp test scripts/responsive-audit.browser.test.ts",
    "test:responsive": "pnpm run test:responsive:provision && pnpm run test:responsive:detector && node --experimental-strip-types scripts/responsive-regression.ts",
    "test:package-smoke": "node --experimental-strip-types scripts/package-smoke.ts",
    "test:grok-live": "node --experimental-strip-types scripts/grok-live-smoke.ts",
    "test:openai-cache-live": "node --experimental-strip-types scripts/openai-cache-live-smoke.ts",
    "test:anthropic-cache-live": "node --experimental-strip-types scripts/anthropic-cache-live-smoke.ts",
    "check:bundle-budget": "node --experimental-strip-types scripts/bundle-budget.ts",
    "audit:test-inventory": "node scripts/test-coverage-inventory.mjs --output docs/test-coverage-inventory.json",
    "slop-check": "node scripts/slop-check.mjs",
    "ultracode:quality": "vp check && node scripts/slop-check.mjs && pnpm run test:coverage && pnpm run test:responsive && vp build && pnpm run check:bundle-budget",
    "check:add-project-flow": "node scripts/check-add-project-flow.mjs",
    "start": "NODE_ENV=production vp exec electron . --no-sandbox",
    "start:web": "HOST=0.0.0.0 NODE_ENV=production node --experimental-strip-types server/web-server.ts",
    "dist:linux": "vp build && electron-builder --linux deb AppImage",
    "dist:linux:appimage": "vp build && electron-builder --linux AppImage",
    "dist:mac": "vp build && electron-builder --mac dmg",
    "dist:mac:arm64": "vp build && electron-builder --mac dmg --arm64",
    "dist:win": "vp build && electron-builder --win nsis",
    "dist:win:portable": "vp build && electron-builder --win portable",
    "mobile:sync": "vp build && cap sync android",
    "mobile:open": "cap open android",
    "mobile:build:debug": "vp build && cap sync android && bash -lc 'cd android && ./gradlew assembleDebug'",
    "mobile:build:release": "vp build && cap sync android && bash -lc 'cd android && ./gradlew assembleRelease'"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/node-server": "^2.0.8",
    "@opengui/backend": "workspace:*",
    "@opengui/protocol": "workspace:*",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tanstack/react-virtual": "^3.14.6",
    "@wooorm/starry-night": "^3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.0",
    "electron-updater": "^6.8.9",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.12.30",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "typebox": "1.3.6",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "agent-browser": "0.33.0",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.1",
    "js-yaml": "^5.2.1",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "sax": "1.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "^0.2.4",
    "vitest": "4.1.9",
    "which": "^7.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "build": {
    "appId": "com.opengui.app",
    "productName": "OpenGUI",
    "compression": "maximum",
    "asar": {
      "smartUnpack": true
    },
    "asarUnpack": [
      "dist-electron/backend.js",
      "dist-electron/backend.js.map",
      "dist-electron/package.json",
      "dist-electron/*.wasm"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "Development",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "compression": "normal",
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "icon": "assets/icon.icns",
      "writeUpdateInfo": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "OpenGUI.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenGUI"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-electron/**/*",
      "package.json",
      "node_modules/typebox/**/*",
      "node_modules/@silvia-odwyer/photon-node/**/*",
      "node_modules/chalk/**/*",
      "node_modules/cli-highlight/**/*",
      "node_modules/diff/**/*",
      "node_modules/extract-zip/**/*",
      "node_modules/file-type/**/*",
      "node_modules/glob/**/*",
      "node_modules/hosted-git-info/**/*",
      "node_modules/ignore/**/*",
      "node_modules/marked/**/*",
      "node_modules/minimatch/**/*",
      "node_modules/proper-lockfile/**/*",
      "node_modules/strip-ansi/**/*",
      "node_modules/undici/**/*",
      "node_modules/uuid/**/*",
      "node_modules/yaml/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/sax/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "akemmanuel",
        "repo": "OpenGUI"
      }
    ],
    "nodeGypRebuild": false,
    "npmRebuild": false
  },
  "desktopName": "OpenGUI"
}
